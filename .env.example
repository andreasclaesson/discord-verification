# bot related
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# must exactly match a redirect registered under OAuth2 > Redirects
DISCORD_REDIRECT_URI=http://localhost:3000/callback

# guild related
GUILD_ID=
VERIFIED_ROLE_ID=
FALLBACK_CHANNEL_ID=

# verification
TOKEN_TTL_MINUTES=30
# any long random string. Used to sign the OAuth2 state param.
STATE_SECRET=

# sqlite path
DATABASE_PATH=./data/verification.sqlite

# web server
WEB_PORT=3000
# publicly reachable base URL of the web package (used to build the /verify links sent in DMs)
PUBLIC_BASE_URL=http://localhost:3000
# if behind a reverse proxy (e.g. nginx), set this to true so the web package can trust the X-Forwarded-* headers.
TRUST_PROXY=false